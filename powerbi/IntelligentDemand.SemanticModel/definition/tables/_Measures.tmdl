/// Reusable DAX measures. Hypothetical inventory values are normalised cost units (NCU).
table _Measures
	lineageTag: c2ce251f-2293-568a-8858-ea55e14b5bec

	/// TRUE when exactly one dataset and one model role are in context for forecast metrics.
	measure 'Forecast Scope Valid' =
			DISTINCTCOUNT ( FactForecastSeriesOrigin[DatasetKey] ) = 1
			    && DISTINCTCOUNT ( FactForecastSeriesOrigin[ModelKey] ) = 1
		isHidden
		displayFolder: _Guards
		lineageTag: 2fe7a646-b740-5f96-8ca8-99727aa76cf1

	/// TRUE when exactly one dataset, one scenario and one policy are in context for inventory metrics.
	measure 'Inventory Scope Valid' =
			DISTINCTCOUNT ( FactInventoryScenarioResults[DatasetKey] ) = 1
			    && DISTINCTCOUNT ( FactInventoryScenarioResults[ScenarioKey] ) = 1
			    && DISTINCTCOUNT ( FactInventoryScenarioResults[PolicyKey] ) = 1
		isHidden
		displayFolder: _Guards
		lineageTag: 711bc27e-45a3-50ed-a222-2246c566f110

	/// Daily forecast observations in context (28 per series and origin).
	measure 'Forecast Observations' = SUM ( FactForecastSeriesOrigin[Observations] )
		formatString: #,##0
		displayFolder: Forecast Accuracy\Coverage
		lineageTag: a7045e6a-c930-5c2c-964c-cb31c47bdba9

	/// Pooled mean absolute error, sum of |forecast - actual| / observations. Validation origins only. Equals the Phase 4 four-origin macro MAE because every series has 28 observations per origin.
	measure MAE =
			IF ( [Forecast Scope Valid],
			    DIVIDE ( SUM ( FactForecastSeriesOrigin[SumAbsError] ), [Forecast Observations] ) )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy
		lineageTag: e421b8c1-f3dc-5f2c-92dd-c6e1b31efca4

	/// Pooled root mean squared error, sqrt(sum of squared errors / observations).
	measure RMSE =
			IF ( [Forecast Scope Valid],
			    SQRT ( DIVIDE ( SUM ( FactForecastSeriesOrigin[SumSquaredError] ), [Forecast Observations] ) ) )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy
		lineageTag: 9f116add-cf37-5de3-b1ec-810400805097

	/// Pooled weighted absolute percentage error, sum |error| / sum actual. Blank when actual demand is zero.
	measure WAPE =
			IF ( [Forecast Scope Valid],
			    DIVIDE ( SUM ( FactForecastSeriesOrigin[SumAbsError] ), SUM ( FactForecastSeriesOrigin[SumActual] ) ) )
		formatString: 0.00%
		displayFolder: Forecast Accuracy
		lineageTag: 1d515cae-3856-54bf-94cd-d907de96856d

	/// Mean forecast minus actual per observation (positive means over-forecasting).
	measure Bias =
			IF ( [Forecast Scope Valid],
			    DIVIDE ( SUM ( FactForecastSeriesOrigin[SumError] ), [Forecast Observations] ) )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy
		lineageTag: 0300f3b6-8b31-55c9-9287-513b450a8777

	/// Sum of forecast minus actual divided by sum of actual demand.
	measure 'Bias %' =
			IF ( [Forecast Scope Valid],
			    DIVIDE ( SUM ( FactForecastSeriesOrigin[SumError] ), SUM ( FactForecastSeriesOrigin[SumActual] ) ) )
		formatString: 0.00%
		displayFolder: Forecast Accuracy
		lineageTag: 25ca62be-4156-5223-b8a0-7ca0f03740c9

	/// Mean over origins of the per-origin mean series MASE (series MAE / lag-7 training scale). Series with an undefined (zero) scale are excluded, matching the Phase 4 definition.
	measure 'Macro MASE' =
			IF ( [Forecast Scope Valid],
			    AVERAGEX (
			        VALUES ( FactForecastSeriesOrigin[OriginKey] ),
			        CALCULATE (
			            AVERAGEX (
			                FILTER ( FactForecastSeriesOrigin, NOT ISBLANK ( FactForecastSeriesOrigin[ScaleAbs] ) ),
			                DIVIDE ( FactForecastSeriesOrigin[SumAbsError], FactForecastSeriesOrigin[Observations] )
			                    / FactForecastSeriesOrigin[ScaleAbs]
			            )
			        )
			    )
			)
		formatString: 0.0000
		displayFolder: Forecast Accuracy
		lineageTag: 30b58ee5-a8bf-584c-aa05-0ba4483162cd

	/// Mean over origins of the per-origin mean series RMSSE (sqrt(series MSE / squared lag-7 training scale)). Undefined scales excluded.
	measure 'Macro RMSSE' =
			IF ( [Forecast Scope Valid],
			    AVERAGEX (
			        VALUES ( FactForecastSeriesOrigin[OriginKey] ),
			        CALCULATE (
			            AVERAGEX (
			                FILTER ( FactForecastSeriesOrigin, NOT ISBLANK ( FactForecastSeriesOrigin[ScaleSquared] ) ),
			                SQRT (
			                    DIVIDE ( FactForecastSeriesOrigin[SumSquaredError], FactForecastSeriesOrigin[Observations] )
			                        / FactForecastSeriesOrigin[ScaleSquared]
			                )
			            )
			        )
			    )
			)
		formatString: 0.0000
		displayFolder: Forecast Accuracy
		lineageTag: dc2f01f4-400f-5ac7-a2f0-a1f079a21fba

	/// Distinct series with validation evaluation rows in context.
	measure 'Evaluated Series' = DISTINCTCOUNT ( FactForecastSeriesOrigin[SeriesKey] )
		formatString: #,##0
		displayFolder: Forecast Accuracy\Coverage
		lineageTag: fd300ca7-68b2-59e8-ad4f-9969a6dccb5f

	/// Evaluated series as a share of the dataset series population in context.
	measure 'Evaluation Coverage' = DIVIDE ( [Evaluated Series], SUM ( DimDataset[SeriesCount] ) )
		formatString: 0.0%
		displayFolder: Forecast Accuracy\Coverage
		lineageTag: 082a0e62-157f-50ca-91af-e4ec399e032b

	/// Distinct validation origins with evaluation rows in context.
	measure 'Validation Origins Evaluated' = DISTINCTCOUNT ( FactForecastSeriesOrigin[OriginKey] )
		formatString: 0
		displayFolder: Forecast Accuracy\Coverage
		lineageTag: 7c9720e8-0b4b-5af0-af1c-abf607897dfd

	/// MAE of the frozen selected ML model, ignoring any model-role filter.
	measure 'MAE Selected ML' = CALCULATE ( [MAE], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "selected_ml" )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: fabb80ca-c168-5115-b8d2-a6cdb357c4d7

	/// MAE of the 28-day moving-average baseline, ignoring any model-role filter.
	measure 'MAE MA28' = CALCULATE ( [MAE], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "moving_average_28" )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: 7b892162-ac18-5c56-adbd-ac2170937f4d

	/// MAE of the seasonal-naive baseline, ignoring any model-role filter.
	measure 'MAE Seasonal Naive' = CALCULATE ( [MAE], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "seasonal_naive" )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: d868d3f0-6c26-5502-a663-fe2cfa4543ad

	/// Relative MAE change of selected ML versus MA28 (negative means lower error).
	measure 'ML vs MA28 MAE Change %' = DIVIDE ( [MAE Selected ML] - [MAE MA28], [MAE MA28] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: 62319d51-3739-5810-846f-7e3dc576e909

	/// Relative MAE change of selected ML versus Seasonal Naive (negative means lower error).
	measure 'ML vs Seasonal Naive MAE Change %' = DIVIDE ( [MAE Selected ML] - [MAE Seasonal Naive], [MAE Seasonal Naive] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: f58c2651-11bb-5c97-9a18-08a4ce21dd7f

	/// Macro MASE of the selected ML model.
	measure 'Macro MASE Selected ML' = CALCULATE ( [Macro MASE], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "selected_ml" )
		formatString: 0.0000
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: 7ca010ae-3362-51f2-aaa3-0fa459b60be7

	/// Macro MASE of MA28. On M5, MA28 has the better macro MASE despite the RF's lower MAE.
	measure 'Macro MASE MA28' = CALCULATE ( [Macro MASE], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "moving_average_28" )
		formatString: 0.0000
		displayFolder: Forecast Accuracy\Comparisons
		lineageTag: 9064a2fa-4883-5749-af94-10445dabeab0

	/// Realised validation sales (a censored-demand proxy). Read from the selected-ML rows because actuals are identical for every model role.
	measure 'Actual Units' =
			IF ( DISTINCTCOUNT ( FactForecastDaily[DatasetKey] ) = 1,
			    CALCULATE ( SUM ( FactForecastDaily[SumActual] ), REMOVEFILTERS ( DimForecastModel ),
			        DimForecastModel[ModelRoleKey] = "selected_ml" ) )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: ca3ecd8f-533e-5822-bc41-a361148a5a37

	/// Saved fixed-origin forecast units for the model role in context (not daily refreshed).
	measure 'Forecast Units' =
			IF ( DISTINCTCOUNT ( FactForecastDaily[DatasetKey] ) = 1
			        && DISTINCTCOUNT ( FactForecastDaily[ModelKey] ) = 1,
			    SUM ( FactForecastDaily[SumForecast] ) )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: f9726490-2df7-5848-8159-166d9413f627

	/// Saved fixed-origin forecast units of the selected ML model.
	measure 'Forecast Units Selected ML' = CALCULATE ( [Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "selected_ml" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 163b158b-7959-5418-8136-5755ff6ccabd

	/// Saved fixed-origin forecast units of MA28.
	measure 'Forecast Units MA28' = CALCULATE ( [Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "moving_average_28" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: d307110b-4758-517b-8cea-17e15be2da47

	/// Saved fixed-origin forecast units of Seasonal Naive.
	measure 'Forecast Units Seasonal Naive' = CALCULATE ( [Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "seasonal_naive" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: b850ea90-5ecc-5aae-94fc-b13f8a3bbc0c

	/// MAE per series-day on the daily fact for one model role.
	measure 'Daily MAE' =
			IF ( DISTINCTCOUNT ( FactForecastDaily[DatasetKey] ) = 1
			        && DISTINCTCOUNT ( FactForecastDaily[ModelKey] ) = 1,
			    DIVIDE ( SUM ( FactForecastDaily[SumAbsError] ), SUM ( FactForecastDaily[Series] ) ) )
		formatString: #,##0.0000
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 4e38a4aa-4f52-5aaf-a1fa-5ddc566422fc

	/// Daily realised sales for detail series (all Store Item; six M5 representatives).
	measure 'Series Actual Units' =
			CALCULATE ( SUM ( FactForecastSeriesDaily[Actual] ), REMOVEFILTERS ( DimForecastModel ),
			    DimForecastModel[ModelRoleKey] = "selected_ml" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 217b1fce-b423-5038-b858-8327194650bb

	/// Daily saved forecast for detail series and the model role in context.
	measure 'Series Forecast Units' = IF ( DISTINCTCOUNT ( FactForecastSeriesDaily[ModelKey] ) = 1, SUM ( FactForecastSeriesDaily[Forecast] ) )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: e9bb21a4-bb4c-59e9-b34e-24b3e1951934

	/// Daily saved forecast of the selected ML model for detail series.
	measure 'Series Forecast Selected ML' = CALCULATE ( [Series Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "selected_ml" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 0cee9493-e72e-57cf-a5c4-ddc89dd53c1b

	/// Daily saved MA28 forecast for detail series.
	measure 'Series Forecast MA28' = CALCULATE ( [Series Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "moving_average_28" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 26757859-316c-5beb-8f94-39267db6def3

	/// Daily saved Seasonal Naive forecast for detail series.
	measure 'Series Forecast Seasonal Naive' = CALCULATE ( [Series Forecast Units], REMOVEFILTERS ( DimForecastModel ), DimForecastModel[ModelRoleKey] = "seasonal_naive" )
		formatString: #,##0.0
		displayFolder: Forecast Accuracy\Daily
		lineageTag: 68b32568-6a3b-551b-9755-dd39a6083156

	/// Series x 28-day episodes in context.
	measure 'Series Episodes' = SUM ( FactInventoryScenarioResults[SeriesEpisodes] )
		formatString: #,##0
		displayFolder: Inventory\Coverage
		lineageTag: 93fbcebe-0cf3-5002-8329-89d6338d875f

	/// Sum of hypothetical normalised cost units. Not a realised financial amount.
	measure 'Total Simulated Cost (NCU)' = IF ( [Inventory Scope Valid], SUM ( FactInventoryScenarioResults[TotalCost] ) )
		formatString: #,##0
		displayFolder: Inventory\Cost
		lineageTag: 823ecbaf-1e6d-5f19-9036-3b9b58e58c75

	/// Total simulated cost / series-episodes. The Phase 5 headline unit. Hypothetical, not savings.
	measure 'Mean Cost per Episode (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[TotalCost] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Cost
		lineageTag: b3ff79f3-e80d-537a-b122-ea8b33e66df5

	/// Holding cost on closing stock per series-episode.
	measure 'Holding Cost per Episode (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[HoldingCost] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Cost
		lineageTag: a65649e6-0b26-5601-85f3-fd2a3eb6cdbc

	/// Fixed plus variable ordering cost per series-episode.
	measure 'Ordering Cost per Episode (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[OrderingCost] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Cost
		lineageTag: b15c8e9b-e4c5-5152-b83b-ea4ad286b757

	/// Shortage penalty on lost (unmet) units per series-episode.
	measure 'Unmet Demand Penalty per Episode (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[ShortageCost] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Cost
		lineageTag: c6ac0393-e911-52b3-bb4c-ce29df4555b7

	/// Terminal exposure charge on closing stock plus pipeline; zero except in the terminal-charge scenario.
	measure 'Terminal Cost per Episode (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[TerminalCost] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Cost
		lineageTag: 7ea4215e-633c-5043-87dc-511708f202cf

	/// Total simulated cost divided by demanded units; a scale-normalised view.
	measure 'Cost per Demanded Unit (NCU)' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[TotalCost] ), SUM ( FactInventoryScenarioResults[DemandUnits] ) ) )
		formatString: #,##0.0000
		displayFolder: Inventory\Cost
		lineageTag: d5aefa9b-5b64-50d8-b1d5-91524a6f2499

	/// Pooled unit fill rate, fulfilled units / demanded units (not an average of series rates).
	measure 'Fill Rate' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[FulfilledUnits] ), SUM ( FactInventoryScenarioResults[DemandUnits] ) ) )
		formatString: 0.00%
		displayFolder: Inventory\Service
		lineageTag: 8ba0df44-1697-562c-886a-a720132549d8

	/// Days with unmet demand per 28-day series-episode.
	measure 'Stockout Days per Episode' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[StockoutDays] ), [Series Episodes] ) )
		formatString: 0.000
		displayFolder: Inventory\Service
		lineageTag: f6b7be87-9719-59f5-9824-400f63169b75

	/// Mean over series-episodes of average daily closing stock.
	measure 'Average On-Hand Units' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[AverageOnHandSum] ), [Series Episodes] ) )
		formatString: #,##0.00
		displayFolder: Inventory\Stock
		lineageTag: 170f6dfb-36cd-5cb6-b73f-980fc2802c07

	/// Positive orders per series-episode.
	measure 'Orders per Episode' = IF ( [Inventory Scope Valid], DIVIDE ( SUM ( FactInventoryScenarioResults[Orders] ), [Series Episodes] ) )
		formatString: 0.00
		displayFolder: Inventory\Stock
		lineageTag: dca0c910-adc6-5d9a-abb3-436d22470625

	/// Share of the 28 episode days on which an order is placed.
	measure 'Order Frequency' = DIVIDE ( [Orders per Episode], 28 )
		formatString: 0.0%
		displayFolder: Inventory\Stock
		lineageTag: d83b633f-948f-502a-ab74-4bdc3727375a

	/// Mean cost per episode under the selected-ML order-up-to policy.
	measure 'Mean Cost Selected ML (NCU)' = CALCULATE ( [Mean Cost per Episode (NCU)], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "selected_ml" )
		formatString: #,##0.00
		displayFolder: Inventory\Comparisons
		lineageTag: c613423b-f185-58a9-bd4b-1ff1bfdac0e8

	/// Mean cost per episode under the MA28 order-up-to policy.
	measure 'Mean Cost MA28 (NCU)' = CALCULATE ( [Mean Cost per Episode (NCU)], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "moving_average_28" )
		formatString: #,##0.00
		displayFolder: Inventory\Comparisons
		lineageTag: eb54c19a-0ba6-5858-886e-ed9810f2b096

	/// Mean cost per episode under the Seasonal Naive order-up-to policy.
	measure 'Mean Cost Seasonal Naive (NCU)' = CALCULATE ( [Mean Cost per Episode (NCU)], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "seasonal_naive" )
		formatString: #,##0.00
		displayFolder: Inventory\Comparisons
		lineageTag: 3576cde5-d930-59a1-9323-59cc61852341

	/// Mean cost per episode under the fixed reorder point, a low-stock and lower-service comparator.
	measure 'Mean Cost Fixed ROP (NCU)' = CALCULATE ( [Mean Cost per Episode (NCU)], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "fixed_reorder_point" )
		formatString: #,##0.00
		displayFolder: Inventory\Comparisons
		lineageTag: b7a3d466-7239-51a0-87ed-106ac6839471

	/// Selected ML minus MA28 mean cost per episode. Negative is a lower hypothetical simulated cost, not a realised saving.
	measure 'ML vs MA28 Cost Difference (NCU)' = [Mean Cost Selected ML (NCU)] - [Mean Cost MA28 (NCU)]
		formatString: +#,##0.00;-#,##0.00;0.00
		displayFolder: Inventory\Comparisons
		lineageTag: 2f95b45f-2a18-5934-a2db-5d38cccb5bed

	/// Selected ML minus MA28 mean cost as a share of MA28 mean cost (hypothetical NCU).
	measure 'ML vs MA28 Cost Difference %' = DIVIDE ( [ML vs MA28 Cost Difference (NCU)], [Mean Cost MA28 (NCU)] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Inventory\Comparisons
		lineageTag: e06e7970-7cce-5e97-a9ae-516e99627711

	/// Selected ML minus Seasonal Naive mean cost per episode (hypothetical NCU).
	measure 'ML vs Seasonal Naive Cost Difference (NCU)' = [Mean Cost Selected ML (NCU)] - [Mean Cost Seasonal Naive (NCU)]
		formatString: +#,##0.00;-#,##0.00;0.00
		displayFolder: Inventory\Comparisons
		lineageTag: c96446f8-6131-5fa6-b7c0-a7ff20002cf6

	/// Selected ML minus Seasonal Naive mean cost as a share of Seasonal Naive mean cost.
	measure 'ML vs Seasonal Naive Cost Difference %' = DIVIDE ( [ML vs Seasonal Naive Cost Difference (NCU)], [Mean Cost Seasonal Naive (NCU)] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Inventory\Comparisons
		lineageTag: b944d3f9-14f7-5323-834c-f2b9142aece3

	/// Selected ML minus MA28 pooled fill rate, in percentage points.
	measure 'ML vs MA28 Fill Rate Difference (pp)' =
			100 * ( CALCULATE ( [Fill Rate], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "selected_ml" )
			    - CALCULATE ( [Fill Rate], REMOVEFILTERS ( DimInventoryPolicy ), DimInventoryPolicy[PolicyKey] = "moving_average_28" ) )
		formatString: +0.00;-0.00;0.00
		displayFolder: Inventory\Comparisons
		lineageTag: e0fddace-2ce1-52e3-b7a2-28a6e909d951

	/// Validation origins at which selected ML has the lower mean simulated cost than MA28.
	measure 'Origins ML Cheaper than MA28' =
			IF ( DISTINCTCOUNT ( FactInventoryScenarioResults[DatasetKey] ) = 1,
			    COUNTROWS ( FILTER ( VALUES ( DimValidationOrigin[OriginKey] ), [ML vs MA28 Cost Difference (NCU)] < 0 ) ) + 0 )
		formatString: 0
		displayFolder: Inventory\Robustness
		lineageTag: be3e2339-718b-5e96-9167-124ec117aa49

	/// Scenarios (origins pooled) where selected ML has the lower mean cost than MA28. The scenarios reuse the same four origins; this is not a count of independent confirmations.
	measure 'Scenarios ML Cheaper than MA28' =
			IF ( DISTINCTCOUNT ( FactInventoryScenarioResults[DatasetKey] ) = 1,
			    COUNTROWS ( FILTER ( VALUES ( DimScenario[ScenarioKey] ), [ML vs MA28 Cost Difference (NCU)] < 0 ) ) + 0 )
		formatString: 0
		displayFolder: Inventory\Robustness
		lineageTag: ec181388-3e5a-5fb1-9200-46d18201affc

	/// Scenarios (origins pooled) where selected ML has the lower mean cost than Seasonal Naive. Not independent replications.
	measure 'Scenarios ML Cheaper than Seasonal Naive' =
			IF ( DISTINCTCOUNT ( FactInventoryScenarioResults[DatasetKey] ) = 1,
			    COUNTROWS ( FILTER ( VALUES ( DimScenario[ScenarioKey] ), [ML vs Seasonal Naive Cost Difference (NCU)] < 0 ) ) + 0 )
		formatString: 0
		displayFolder: Inventory\Robustness
		lineageTag: fe2d7b5c-4083-53b7-8e59-1da362d610b2

	/// Base scenario series-origin pairs where selected ML costs less than MA28 (tolerance 1e-8 NCU).
	measure 'Series-Origins ML Cheaper than MA28' =
			IF ( DISTINCTCOUNT ( FactInventorySeriesBase[DatasetKey] ) = 1,
			    SUMX (
			        SUMMARIZE ( FactInventorySeriesBase, FactInventorySeriesBase[SeriesKey], FactInventorySeriesBase[OriginKey] ),
			        VAR _ml = CALCULATE ( SUM ( FactInventorySeriesBase[TotalCost] ), REMOVEFILTERS ( DimInventoryPolicy ),
			            DimInventoryPolicy[PolicyKey] = "selected_ml" )
			        VAR _ma = CALCULATE ( SUM ( FactInventorySeriesBase[TotalCost] ), REMOVEFILTERS ( DimInventoryPolicy ),
			            DimInventoryPolicy[PolicyKey] = "moving_average_28" )
			        RETURN IF ( _ml < _ma - 0.00000001, 1, 0 )
			    ) )
		formatString: #,##0
		displayFolder: Inventory\Robustness
		lineageTag: 3f2a814d-b32b-5f26-ad81-0b8f250955bd

	/// Base scenario series-origin pairs where selected ML costs more than MA28 (tolerance 1e-8 NCU).
	measure 'Series-Origins ML Costlier than MA28' =
			IF ( DISTINCTCOUNT ( FactInventorySeriesBase[DatasetKey] ) = 1,
			    SUMX (
			        SUMMARIZE ( FactInventorySeriesBase, FactInventorySeriesBase[SeriesKey], FactInventorySeriesBase[OriginKey] ),
			        VAR _ml = CALCULATE ( SUM ( FactInventorySeriesBase[TotalCost] ), REMOVEFILTERS ( DimInventoryPolicy ),
			            DimInventoryPolicy[PolicyKey] = "selected_ml" )
			        VAR _ma = CALCULATE ( SUM ( FactInventorySeriesBase[TotalCost] ), REMOVEFILTERS ( DimInventoryPolicy ),
			            DimInventoryPolicy[PolicyKey] = "moving_average_28" )
			        RETURN IF ( _ml > _ma + 0.00000001, 1, 0 )
			    ) )
		formatString: #,##0
		displayFolder: Inventory\Robustness
		lineageTag: 983d5dc0-c116-5971-adb7-bae62d1b23fa

	/// Distinct hypothetical scenarios with results in context.
	measure 'Scenario Count' = DISTINCTCOUNT ( FactInventoryScenarioResults[ScenarioKey] )
		formatString: 0
		displayFolder: Governance
		lineageTag: b385e80b-14e1-5993-8520-c3a0a0cf87a3

	/// Distinct completed Phase 5 inventory cases (origin x scenario x policy) in context.
	measure 'Inventory Cases' = DISTINCTCOUNT ( FactInventoryScenarioResults[CaseId] )
		formatString: #,##0
		displayFolder: Governance
		lineageTag: d78eb737-432d-5243-b682-90250e1d41b5

	/// Frozen Phase 4 selected trial for the single dataset in context.
	measure 'Selected Forecast Model' = SELECTEDVALUE ( DimDataset[SelectedTrial], "Select one dataset" )
		displayFolder: Governance
		lineageTag: 4f444a1a-d9d2-57c5-8c5b-1112f74f7e31

	/// Saved verification receipts loaded into the model.
	measure 'Verification Receipts' = COUNTROWS ( FactScientificValidation )
		formatString: 0
		displayFolder: Governance
		lineageTag: dff9038b-2ab9-5b31-a406-561c5d6ec544

	/// Receipts whose own recorded status is "passed".
	measure 'Verification Receipts Passed' = COUNTROWS ( FILTER ( FactScientificValidation, FactScientificValidation[Status] = "passed" ) ) + 0
		formatString: 0
		displayFolder: Governance
		lineageTag: e590a9c5-eefd-5795-b95d-90fa4e47289e

	/// Independent-audit findings in context.
	measure 'Audit Findings' = COUNTROWS ( DimAuditFinding )
		formatString: 0
		displayFolder: Governance
		lineageTag: a0f7e684-8e83-58c5-8e06-2060bf0bbff5

	/// Findings whose recorded status starts with "Open".
	measure 'Open Audit Findings' = COUNTROWS ( FILTER ( DimAuditFinding, LEFT ( DimAuditFinding[Status], 4 ) = "Open" ) ) + 0
		formatString: 0
		displayFolder: Governance
		lineageTag: c02c660a-8377-5117-8876-29f53c4f49b2

	/// Selected dataset label, or a prompt when none or both are selected.
	measure 'Title Dataset' = SELECTEDVALUE ( DimDataset[Dataset], "Select one dataset" )
		displayFolder: Titles
		lineageTag: 10ae9597-3c8b-57a8-8a20-5a6bb19f52a7

	/// Dynamic title for the forecasting page.
	measure 'Title Forecast Page' = "Forecast accuracy | " & [Title Dataset] & " | validation origins only (not the final holdout)"
		displayFolder: Titles
		lineageTag: abd3dc5a-5836-537a-8938-488e63d76170

	/// Dynamic title for the inventory page.
	measure 'Title Inventory Page' = "Inventory policies | " & [Title Dataset] & " | " & SELECTEDVALUE ( DimScenario[Scenario], "select one scenario" ) & " | hypothetical NCU"
		displayFolder: Titles
		lineageTag: 1e78c353-11a5-5fd9-b5d9-ef2553d191ec

	/// Dynamic title for the scenario page.
	measure 'Title Scenario Page' = "Scenario sensitivity | " & [Title Dataset] & " | 17 scenarios share the same four origins"
		displayFolder: Titles
		lineageTag: 58d6d62d-8c57-5826-8210-3ef46fae4164

