 "limitations": [
  {
   "limitationId": "L1",
   "limitation": "Inventory costs are hypothetical normalised cost units (NCU), not realised financial savings.",
   "sourceDocument": "docs/PHASE5_LIMITATIONS.md"
  },
  {
   "limitationId": "L2",
   "limitation": "Better forecast accuracy does not guarantee better simulated inventory outcomes.",
   "sourceDocument": "docs/PHASE5_AUDIT_RESPONSE.md"
  },
  {
   "limitationId": "L3",
   "limitation": "Store Item selected ML's pooled simulated cost advantage over MA28 reverses at the last validation origin.",
   "sourceDocument": "docs/PHASE5_AUDIT_RESPONSE.md"
  },
  {
   "limitationId": "L4",
   "limitation": "The 17 scenarios reuse the same four origins, forecasts and series; they are not independent replications.",
   "sourceDocument": "docs/PHASE5_SENSITIVITY_ANALYSIS.md"
  },
  {
   "limitationId": "L5",
   "limitation": "Fixed reorder point is a low-stock comparator whose lower cost comes with lower fill rate.",
   "sourceDocument": "docs/PHASE5_AUDIT_RESPONSE.md"
  },
  {
   "limitationId": "L6",
   "limitation": "ML models were tuned and selected on the same validation windows used for these comparisons; baselines were not tuned.",
   "sourceDocument": "docs/PHASE5_AUDIT_RESPONSE.md"
  },
  {
   "limitationId": "L7",
   "limitation": "M5 sparse-demand performance differs materially by series segment; MA28 beats the RF on the all-zero-label group.",
   "sourceDocument": "docs/PHASE5_AUDIT_RESPONSE.md"
  },
  {
   "limitationId": "L8",
   "limitation": "No actual inventory transactions, supplier lead times or true stockout costs are available; sales proxy censored demand.",
   "sourceDocument": "docs/PHASE5_LIMITATIONS.md"
  }
 ],
 "auditFindings": [
  {
   "findingId": "F-01",
   "severity": "Medium",
   "finding": "Checkpoint not committed; documents contradict each other",
   "disposition": "README, roadmap, academic requirements, completion checklist, handoff and progress note corrected. Reviewed files committed in one local commit; the hash is not written into committed files. A git-ignored local receipt records it.",
   "status": "Resolved by this checkpoint"
  },
  {
   "findingId": "F-02",
   "severity": "Medium",
   "finding": "No off-device evidence copy",
   "disposition": "Both backups are local to the same laptop. No copy was made and neither backup was modified. Owner action needed.",
   "status": "Open; blocks academic submission, not the start of Phase 6"
  },
  {
   "findingId": "F-03",
   "severity": "Medium",
   "finding": "Fixed ROP is a degenerate comparator",
   "disposition": "Described everywhere as a low-stock, low-service comparator, with the Store Item and M5 behaviour reported separately (see section 4). No tuned (s, S) comparator was added because that needs a new experiment.",
   "status": "Documented; optional future experiment"
  },
  {
   "findingId": "F-04",
   "severity": "Medium",
   "finding": "Headline ML result less robust than presented",
   "disposition": "Per-origin tables, Seasonal Naive comparison, scenario non-independence and the Store Item sign reversal added to results, sensitivity, limitations and the HTML report.",
   "status": "Resolved in reporting"
  },
  {
   "findingId": "F-05",
   "severity": "Medium",
   "finding": "Selection optimism from reused validation origins",
   "disposition": "Asymmetric tuning disclosed with configuration counts. The bias cannot be quantified because the final holdout is consumed.",
   "status": "Documented limitation"
  },
  {
   "findingId": "F-06",
   "severity": "Medium",
   "finding": "M5 sparse-demand weakness",
   "disposition": "Subgroup table and wording added; no re-selection.",
   "status": "Documented limitation"
  },
  {
   "findingId": "F-07",
   "severity": "Low",
   "finding": "Volume-weighted mean cost, many ties",
   "disposition": "Median, tie counts and cost per demanded unit added from saved per-series outputs.",
   "status": "Resolved in reporting"
  },
  {
   "findingId": "F-08",
   "severity": "Low",
   "finding": "Chronology self-recorded; freeze recorded a dirty tree",
   "disposition": "Unchanged and still disclosed.",
   "status": "Accepted limitation"
  },
  {
   "findingId": "F-09",
   "severity": "Low",
   "finding": "Finite-episode artefacts",
   "disposition": "Caveats retained and attached to scenario results.",
   "status": "Accepted limitation"
  },
  {
   "findingId": "F-10",
   "severity": "Low",
   "finding": "Environment snapshot not portable; clean-room run untested",
   "disposition": "No change.",
   "status": "Open, optional"
  },
  {
   "findingId": "F-11",
   "severity": "Info",
   "finding": "Scalar reference shares the input adapter and was amended",
   "disposition": "Independent replays and exact-integer re-simulation passed; nothing further.",
   "status": "Closed"
  },
  {
   "findingId": "F-12",
   "severity": "Info",
   "finding": "Variability stress changes mean and zeros",
   "disposition": "Already documented.",
   "status": "Closed"
  }
 ],
