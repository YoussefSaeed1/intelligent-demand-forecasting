# DemandIQ web (apps/web) environment template. Copy to .env.local for local work; never commit real values.
# All variables are SERVER-ONLY. Do not prefix any of them with NEXT_PUBLIC_.

# Postgres connection for the least-privilege webapp_api role (Supabase transaction pooler in production:
# postgresql://webapp_api.<project-ref>:<password>@<pooler-host>:6543/postgres).
WEBAPP_DATABASE_URL=

# Postgres URL notes: keep ?sslmode=require (TLS is always on for remote hosts, minimum TLS 1.2). The libpq option
# ssl_min_protocol_version is accepted and applied as a Node TLS option (it is never sent to the server).

# Base URL of the private FastAPI engine service (apps/engine): the engine PRODUCTION domain, HTTPS, no path/query,
# e.g. https://idf-engine.vercel.app. Plain http is accepted only for a loopback engine (local tests).
ENGINE_URL=

# Vercel "Protection Bypass for Automation" secret of the ENGINE project (its deployments are protected for All
# Deployments). Sent server-to-server as x-vercel-protection-bypass. Required whenever ENGINE_URL is not loopback.
VERCEL_PROTECTION_BYPASS_SECRET=

# Shared secret sent server-to-server as X-Engine-Key; same value in the engine project. At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENGINE_SHARED_KEY=

# Salt for hashing client addresses in the Postgres rate limiter (raw IPs are never stored). At least 32 characters.
RATE_LIMIT_SALT=

# Optional rate-limit overrides (defaults shown).
# RATE_LIMIT_SIMULATE_PER_MINUTE=30
# RATE_LIMIT_SIMULATE_PER_DAY=300
# RATE_LIMIT_READ_PER_MINUTE=120
